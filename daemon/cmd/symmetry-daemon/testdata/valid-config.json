{
  "control_plane_url": "https://control.example.test/api",
  "state_dir": ".symmetry/state",
  "machine_name": "builder-01",
  "cleanup_timeout_ms": 120000,
  "agent_profiles": {
    "default": {
      "command": "codex",
      "args": [],
      "input_mode": "goal",
      "env_allowlist": []
    }
  },
  "workspaces": {
    "primary": {
      "policy": "git_worktree",
      "repository": "Q:/workspaces",
      "root": "Q:/workspaces/.symmetry/worktrees",
      "ref": "HEAD",
      "cleanup": "always"
    }
  },
  "runtime": {
    "runtime_key": "default",
    "name": "docker",
    "capacity": 4,
    "agent_profile": "default",
    "workspace": "primary"
  }
}
