{
  "control_plane_url": "http://control:4000",
  "allow_insecure_http": true,
  "state_dir": "/var/lib/symmetry",
  "machine_name": "compose-daemon",
  "cleanup_timeout_ms": 120000,
  "agent_profiles": {
    "default": {
      "command": "/symmetry-fake-agent",
      "args": [],
      "input_mode": "json",
      "interactive": true,
      "event_format": "jsonl",
      "env_allowlist": []
    }
  },
  "workspaces": {
    "primary": {
      "policy": "existing_checkout",
      "path": "/workspaces",
      "cleanup": "never"
    }
  },
  "runtime": {
    "runtime_key": "default",
    "name": "default",
    "capacity": 1,
    "agent_profile": "default",
    "workspace": "primary"
  }
}
