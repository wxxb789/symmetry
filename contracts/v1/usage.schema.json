{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contracts/v1/usage.schema.json",
  "title": "Symmetry Usage v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "usage_id",
    "run_id",
    "usage_key",
    "provider",
    "model",
    "input_tokens",
    "output_tokens",
    "cached_input_tokens",
    "cost_microusd",
    "cost_basis",
    "price_version",
    "supersedes_id",
    "observed_at"
  ],
  "properties": {
    "schema_version": {"const": "symmetry.usage.v1"},
    "usage_id": {"$ref": "common.schema.json#/definitions/UUID"},
    "run_id": {"$ref": "common.schema.json#/definitions/UUID"},
    "usage_key": {"$ref": "common.schema.json#/definitions/ShortIdentifier"},
    "provider": {"$ref": "common.schema.json#/definitions/ShortIdentifier"},
    "model": {"$ref": "common.schema.json#/definitions/ShortIdentifier"},
    "input_tokens": {
      "oneOf": [
        {"$ref": "common.schema.json#/definitions/SafeInteger"},
        {"type": "null"}
      ]
    },
    "output_tokens": {
      "oneOf": [
        {"$ref": "common.schema.json#/definitions/SafeInteger"},
        {"type": "null"}
      ]
    },
    "cached_input_tokens": {
      "oneOf": [
        {"$ref": "common.schema.json#/definitions/SafeInteger"},
        {"type": "null"}
      ]
    },
    "cost_microusd": {
      "oneOf": [
        {"$ref": "common.schema.json#/definitions/Microusd"},
        {"type": "null"}
      ]
    },
    "cost_basis": {"enum": ["reported", "estimated", "unknown"]},
    "price_version": {
      "oneOf": [
        {"$ref": "common.schema.json#/definitions/ShortIdentifier"},
        {"type": "null"}
      ]
    },
    "supersedes_id": {
      "oneOf": [
        {"$ref": "common.schema.json#/definitions/UUID"},
        {"type": "null"}
      ]
    },
    "observed_at": {"$ref": "common.schema.json#/definitions/UtcTimestamp"}
  },
  "oneOf": [
    {
      "properties": {
        "cost_basis": {"const": "unknown"},
        "cost_microusd": {"type": "null"}
      }
    },
    {
      "properties": {
        "cost_basis": {"enum": ["reported", "estimated"]},
        "cost_microusd": {"$ref": "common.schema.json#/definitions/Microusd"}
      }
    }
  ]
}
