{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contracts/v1/evidence-batch-response.schema.json",
  "title": "Symmetry Evidence Batch Response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_batch"],
  "properties": {
    "evidence_batch": {"$ref": "#/definitions/EvidenceBatch"}
  },
  "definitions": {
    "EvidenceBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "receipts"],
      "properties": {
        "run_id": {"$ref": "common.schema.json#/definitions/UUID"},
        "receipts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {"$ref": "#/definitions/EvidenceReceipt"}
        }
      }
    },
    "EvidenceReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "run_id", "evidence_key", "kind", "subject_hash", "verdict", "observed_at", "disposition"],
      "properties": {
        "id": {"$ref": "common.schema.json#/definitions/UUID"},
        "run_id": {"$ref": "common.schema.json#/definitions/UUID"},
        "evidence_key": {"$ref": "common.schema.json#/definitions/ShortIdentifier"},
        "kind": {"enum": ["check", "artifact", "review", "observation"]},
        "subject_hash": {"$ref": "common.schema.json#/definitions/Sha256"},
        "verdict": {"enum": ["passed", "failed", "unknown", "not_applicable"]},
        "observed_at": {"$ref": "common.schema.json#/definitions/UtcTimestamp"},
        "disposition": {"enum": ["created", "replayed"]}
      }
    }
  }
}
