{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contracts/v1/chat-read.schema.json",
  "title": "Symmetry Chat Read v1",
  "description": "Consumed fields of SymmetryControl.Chat.conversation/1 (GET /portal/api/chat): the server-resolved scope, the scoped message page and the newest work items' detail projections. Unconsumed presentation fields remain additive.",
  "type": "object",
  "additionalProperties": true,
  "required": ["scope", "project_id", "run_id", "messages", "runs", "next_before"],
  "properties": {
    "scope": {"enum": ["workspace", "project", "run"]},
    "project_id": {
      "oneOf": [{"$ref": "common.schema.json#/definitions/UUID"}, {"type": "null"}]
    },
    "run_id": {"oneOf": [{"$ref": "common.schema.json#/definitions/UUID"}, {"type": "null"}]},
    "messages": {"type": "array", "items": {"$ref": "#/definitions/ChatMessage"}},
    "runs": {"type": "array", "items": {"$ref": "#/definitions/ChatRun"}},
    "next_before": {"oneOf": [{"type": "string"}, {"type": "null"}]}
  },
  "definitions": {
    "ChatMessage": {
      "type": "object",
      "additionalProperties": true,
      "description": "Chat.message_json/1: one durable conversation message as served in the scoped page, oldest first. discuss and status questions never create a command, so command stays null for them.",
      "required": [
        "id",
        "role",
        "intent",
        "content",
        "inserted_at",
        "work_item_id",
        "command",
        "metadata"
      ],
      "properties": {
        "id": {"$ref": "common.schema.json#/definitions/UUID"},
        "role": {"enum": ["human", "assistant"]},
        "intent": {"type": "string"},
        "content": {"type": "string"},
        "inserted_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "work_item_id": {
          "oneOf": [{"$ref": "common.schema.json#/definitions/UUID"}, {"type": "null"}]
        },
        "command": {"oneOf": [{"$ref": "#/definitions/ChatCommand"}, {"type": "null"}]},
        "metadata": {
          "oneOf": [{"type": "object", "additionalProperties": true}, {"type": "null"}]
        }
      }
    },
    "ChatCommand": {
      "type": "object",
      "additionalProperties": true,
      "description": "Protocol.command/1 as embedded in a chat message receipt. Task-scoped commands (a cancel or retry recorded before any run exists) carry run_id and generation as null; run-scoped commands carry both.",
      "required": [
        "command_id",
        "task_id",
        "run_id",
        "generation",
        "kind",
        "payload",
        "state",
        "issued_at",
        "applied_at",
        "acknowledgement_id",
        "acknowledgement_outcome",
        "acknowledged_at"
      ],
      "properties": {
        "command_id": {"$ref": "common.schema.json#/definitions/UUID"},
        "task_id": {"$ref": "common.schema.json#/definitions/UUID"},
        "run_id": {"oneOf": [{"$ref": "common.schema.json#/definitions/UUID"}, {"type": "null"}]},
        "generation": {"oneOf": [{"type": "integer"}, {"type": "null"}]},
        "kind": {"type": "string"},
        "payload": {"type": "object", "additionalProperties": true},
        "state": {"type": "string"},
        "issued_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "applied_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "acknowledgement_id": {
          "oneOf": [{"$ref": "common.schema.json#/definitions/UUID"}, {"type": "null"}]
        },
        "acknowledgement_outcome": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "acknowledged_at": {
          "oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]
        }
      }
    },
    "ChatRun": {
      "type": "object",
      "additionalProperties": true,
      "description": "Chat.ReadModel.runs/2 entry: the work detail projection behind one scoped work item, newest first and capped at the read model's run limit. raw.timeline is blanked to [] while keeping the same members because the chat read serves no raw history rows; the work detail endpoint remains the diagnostic surface for raw events.",
      "required": ["work_item", "outcome", "timeline", "raw"],
      "properties": {
        "work_item": {"$ref": "#/definitions/WorkspaceWorkItem"},
        "outcome": {"$ref": "#/definitions/WorkItemOutcome"},
        "timeline": {"type": "array", "items": {"$ref": "#/definitions/WorkItemTimelineItem"}},
        "raw": {"$ref": "#/definitions/WorkDetailRaw"}
      }
    },
    "WorkspaceWorkItem": {
      "type": "object",
      "additionalProperties": true,
      "description": "PortalJSON.work_item/2 as served in workspace rows and work detail reads. The definition body is identical in workspace-read.schema.json and work-detail-read.schema.json so the effect generator shares one graph for both roots; the JSON Schema to TypeScript modules and the quicktype Go output may still restate the shape per root.",
      "required": ["id", "key", "title", "status", "blocked", "blocker"],
      "properties": {
        "id": {"$ref": "common.schema.json#/definitions/UUID"},
        "key": {"type": "string"},
        "project_id": {"$ref": "common.schema.json#/definitions/UUID"},
        "goal_id": {"oneOf": [{"$ref": "common.schema.json#/definitions/UUID"}, {"type": "null"}]},
        "title": {"type": "string"},
        "description": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "status": {"type": "string"},
        "priority": {"type": "string"},
        "position": {"type": "integer"},
        "assignee": {"$ref": "#/definitions/WorkItemAssignee"},
        "workspace": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "blocked": {"type": "boolean"},
        "blocker": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "repository_resource_id": {
          "oneOf": [{"$ref": "common.schema.json#/definitions/UUID"}, {"type": "null"}]
        },
        "repository": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "ci_resource_id": {
          "oneOf": [{"$ref": "common.schema.json#/definitions/UUID"}, {"type": "null"}]
        },
        "ci_resource": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "branch": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "pull_request_url": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "ci_status": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "review_status": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "delivery": {"$ref": "#/definitions/WorkItemDelivery"},
        "external": {"oneOf": [{"$ref": "#/definitions/WorkItemExternal"}, {"type": "null"}]},
        "goal_managed": {
          "type": "boolean",
          "description": "True only when the all-or-nothing Goal membership (goal_id, admitted_revision, acceptance_contract) is set; served so a client can present no writable path for a Goal-managed item."
        },
        "version": {"type": "integer"},
        "can_start": {"type": "boolean"},
        "execution": {"oneOf": [{"$ref": "#/definitions/WorkItemExecution"}, {"type": "null"}]},
        "updated_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]}
      }
    },
    "WorkItemAssignee": {
      "type": "object",
      "additionalProperties": true,
      "description": "PortalJSON owner/1: assignee identity as served, with null members when unset.",
      "required": ["type", "name", "agent_profile"],
      "properties": {
        "type": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "name": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "agent_profile": {"oneOf": [{"type": "string"}, {"type": "null"}]}
      }
    },
    "WorkItemDelivery": {
      "type": "object",
      "additionalProperties": true,
      "required": ["pull_request", "ci", "review"],
      "properties": {
        "pull_request": {"$ref": "#/definitions/WorkItemDeliveryValue"},
        "ci": {"$ref": "#/definitions/WorkItemDeliveryValue"},
        "review": {"$ref": "#/definitions/WorkItemDeliveryValue"}
      }
    },
    "WorkItemDeliveryValue": {
      "type": "object",
      "additionalProperties": true,
      "description": "PortalJSON effective_delivery/6: the consumed core is value, source, generation, url and status; provider, recorded_at and other evidence fields stay source-specific and additive.",
      "required": ["value", "source", "generation", "url", "status"],
      "properties": {
        "value": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "source": {"enum": ["none", "manual", "provider", "agent"]},
        "generation": {"oneOf": [{"type": "integer"}, {"type": "null"}]},
        "url": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "status": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "provider": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "recorded_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]}
      }
    },
    "WorkItemExecution": {
      "type": "object",
      "additionalProperties": true,
      "description": "PortalJSON.execution_summary/1 as served when the work item has an orchestration task; null otherwise.",
      "required": [
        "task_id",
        "run_id",
        "runtime_id",
        "generation",
        "state",
        "waiting",
        "latest_command",
        "result",
        "failure",
        "timing",
        "supervisory_control",
        "can_guide",
        "can_pause",
        "can_resume",
        "can_cancel",
        "can_retry",
        "intent_locked"
      ],
      "properties": {
        "task_id": {"$ref": "common.schema.json#/definitions/UUID"},
        "run_id": {"oneOf": [{"$ref": "common.schema.json#/definitions/UUID"}, {"type": "null"}]},
        "runtime_id": {
          "oneOf": [{"$ref": "common.schema.json#/definitions/UUID"}, {"type": "null"}]
        },
        "generation": {"type": "integer"},
        "state": {"type": "string"},
        "waiting": {"oneOf": [{"$ref": "#/definitions/WorkItemWaiting"}, {"type": "null"}]},
        "latest_command": {
          "oneOf": [{"$ref": "#/definitions/WorkItemCommand"}, {"type": "null"}]
        },
        "result": {
          "oneOf": [{"type": "object", "additionalProperties": true}, {"type": "null"}]
        },
        "failure": {
          "oneOf": [{"type": "object", "additionalProperties": true}, {"type": "null"}]
        },
        "timing": {"$ref": "#/definitions/WorkItemExecutionTiming"},
        "supervisory_control": {"type": "boolean"},
        "can_guide": {"type": "boolean"},
        "can_pause": {"type": "boolean"},
        "can_resume": {"type": "boolean"},
        "can_cancel": {"type": "boolean", "description": "True when the task state permits a cancel and, while a runtime holds the attempt (claimed and beyond), that runtime advertises the adapter `cancel` operation; cancel of a queued or assigned attempt is applied by the control plane itself. A runtime without the advertisement is unknown and answers false."},
        "can_retry": {"type": "boolean", "description": "True when the task state permits a retry, the work item's agent-assignment, external-work and active-project conditions hold, and at least one runtime assignment could select for the task (same binding and capability containment, ignoring transient online state) advertises the adapter `start` operation the fresh retried attempt uses. No such runtime answers false."},
        "intent_locked": {"type": "boolean"}
      }
    },
    "WorkItemExecutionTiming": {
      "type": "object",
      "additionalProperties": true,
      "required": ["state_since", "started_at", "finished_at"],
      "properties": {
        "state_since": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "started_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "finished_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]}
      }
    },
    "WorkItemWaiting": {
      "type": "object",
      "additionalProperties": true,
      "description": "Protocol.waiting/1: current waiting_for_input context; the decision packet stays open because it is carried verbatim from the runtime payload.",
      "required": ["run_id", "generation", "transition_id", "question", "decision", "payload", "recorded_at"],
      "properties": {
        "run_id": {"$ref": "common.schema.json#/definitions/UUID"},
        "generation": {"type": "integer"},
        "transition_id": {"$ref": "common.schema.json#/definitions/UUID"},
        "question": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "decision": {
          "oneOf": [{"$ref": "#/definitions/WorkItemWaitingDecision"}, {"type": "null"}]
        },
        "payload": {"type": "object", "additionalProperties": true},
        "recorded_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]}
      }
    },
    "WorkItemWaitingDecision": {
      "type": "object",
      "additionalProperties": true,
      "description": "Agent-supplied waiting_for_input decision packet; options and recommendation are advisory display data.",
      "properties": {
        "context": {"type": "string"},
        "reason": {"type": "string"},
        "options": {
          "type": "array",
          "items": {"$ref": "#/definitions/WorkItemWaitingDecisionOption"}
        },
        "recommended_option_id": {"oneOf": [{"type": "string"}, {"type": "null"}]}
      }
    },
    "WorkItemWaitingDecisionOption": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {"type": "string"},
        "label": {"type": "string"},
        "consequence": {"type": "string"}
      }
    },
    "WorkItemCommand": {
      "type": "object",
      "additionalProperties": true,
      "description": "Protocol.command/1: latest guidance command receipt for the current generation. Task-scoped commands (a cancel or retry recorded before any run exists) carry run_id and generation as null; run-scoped commands carry both.",
      "required": [
        "command_id",
        "task_id",
        "run_id",
        "generation",
        "kind",
        "payload",
        "state",
        "issued_at",
        "applied_at",
        "acknowledgement_id",
        "acknowledgement_outcome",
        "acknowledged_at"
      ],
      "properties": {
        "command_id": {"$ref": "common.schema.json#/definitions/UUID"},
        "task_id": {"$ref": "common.schema.json#/definitions/UUID"},
        "run_id": {"oneOf": [{"$ref": "common.schema.json#/definitions/UUID"}, {"type": "null"}]},
        "generation": {"oneOf": [{"type": "integer"}, {"type": "null"}]},
        "kind": {"type": "string"},
        "payload": {"type": "object", "additionalProperties": true},
        "state": {"type": "string"},
        "issued_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "applied_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "acknowledgement_id": {
          "oneOf": [{"$ref": "common.schema.json#/definitions/UUID"}, {"type": "null"}]
        },
        "acknowledgement_outcome": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "acknowledged_at": {
          "oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]
        }
      }
    },
    "WorkItemExternal": {
      "type": "object",
      "additionalProperties": true,
      "description": "PortalJSON.external_work_item/1 safe display and link fields; raw provider payloads (data, delivery_data) remain additive and unconsumed.",
      "required": [
        "provider",
        "id",
        "url",
        "state",
        "available",
        "assignee",
        "labels",
        "updated_at",
        "resource_id"
      ],
      "properties": {
        "provider": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "id": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "url": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "state": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "available": {"type": "boolean"},
        "assignee": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "labels": {"type": "array", "items": {"type": "string"}},
        "updated_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "resource_id": {
          "oneOf": [{"$ref": "common.schema.json#/definitions/UUID"}, {"type": "null"}]
        },
        "provider_owned_fields": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Field names the external tracker owns; write refusals still come from Control."
        }
      }
    },
    "WorkItemOutcome": {
      "type": "object",
      "additionalProperties": true,
      "description": "PortalJSON outcome/5: reported execution output with blocker and delivery summary. summary and tests are carried verbatim from the task result or its evidence fallback (legacy payloads may hold objects or strings), while result and failure bodies stay open-ended.",
      "required": [
        "goal",
        "phase",
        "owner",
        "summary",
        "findings",
        "changed_artifacts",
        "tests",
        "blocker",
        "pull_request_url",
        "ci_status",
        "review_status",
        "delivery",
        "result",
        "failure"
      ],
      "properties": {
        "goal": {"type": "string"},
        "phase": {"type": "string"},
        "owner": {"$ref": "#/definitions/WorkItemAssignee"},
        "summary": {},
        "findings": {"type": "array", "items": {}},
        "changed_artifacts": {"type": "array", "items": {}},
        "tests": {},
        "blocker": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "pull_request_url": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "ci_status": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "review_status": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "delivery": {"$ref": "#/definitions/WorkItemDelivery"},
        "result": {
          "oneOf": [{"type": "object", "additionalProperties": true}, {"type": "null"}]
        },
        "failure": {
          "oneOf": [{"type": "object", "additionalProperties": true}, {"type": "null"}]
        }
      }
    },
    "WorkItemTimelineItem": {
      "type": "object",
      "additionalProperties": true,
      "description": "Protocol.timeline_page/2 item shared by work detail raw.timeline and the timeline read; data is discriminated on source. Command items carry null run_id and generation when the command is task-scoped, while event and transition items always keep run-scoped identities.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "source": {"const": "event"},
            "run_id": {"$ref": "common.schema.json#/definitions/UUID"},
            "generation": {"type": "integer"},
            "recorded_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
            "data": {"$ref": "#/definitions/TimelineEventData"}
          },
          "required": ["source", "run_id", "generation", "recorded_at", "data"]
        },
        {
          "type": "object",
          "properties": {
            "source": {"const": "transition"},
            "run_id": {"$ref": "common.schema.json#/definitions/UUID"},
            "generation": {"type": "integer"},
            "recorded_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
            "data": {"$ref": "#/definitions/TimelineTransitionData"}
          },
          "required": ["source", "run_id", "generation", "recorded_at", "data"]
        },
        {
          "type": "object",
          "properties": {
            "source": {"const": "command"},
            "run_id": {"oneOf": [{"$ref": "common.schema.json#/definitions/UUID"}, {"type": "null"}]},
            "generation": {"oneOf": [{"type": "integer"}, {"type": "null"}]},
            "recorded_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
            "data": {"$ref": "#/definitions/TimelineCommandData"}
          },
          "required": ["source", "run_id", "generation", "recorded_at", "data"]
        }
      ]
    },
    "TimelineEventData": {
      "type": "object",
      "additionalProperties": true,
      "description": "Timeline event payload with run identity removed by Protocol.timeline_data/2.",
      "required": ["event_id", "sequence", "kind", "payload", "occurred_at"],
      "properties": {
        "event_id": {"$ref": "common.schema.json#/definitions/UUID"},
        "sequence": {"type": "integer"},
        "kind": {"type": "string"},
        "payload": {"type": "object", "additionalProperties": true},
        "occurred_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]}
      }
    },
    "TimelineTransitionData": {
      "type": "object",
      "additionalProperties": true,
      "description": "Timeline transition payload with run identity removed by Protocol.timeline_data/2.",
      "required": ["transition_id", "state", "payload"],
      "properties": {
        "transition_id": {"$ref": "common.schema.json#/definitions/UUID"},
        "state": {"type": "string"},
        "payload": {"type": "object", "additionalProperties": true}
      }
    },
    "TimelineCommandData": {
      "type": "object",
      "additionalProperties": true,
      "description": "Timeline command receipt with run_id and generation removed by Protocol.timeline_data/2.",
      "required": [
        "command_id",
        "task_id",
        "kind",
        "payload",
        "state",
        "issued_at",
        "applied_at",
        "acknowledgement_id",
        "acknowledgement_outcome",
        "acknowledged_at"
      ],
      "properties": {
        "command_id": {"$ref": "common.schema.json#/definitions/UUID"},
        "task_id": {"$ref": "common.schema.json#/definitions/UUID"},
        "kind": {"type": "string"},
        "payload": {"type": "object", "additionalProperties": true},
        "state": {"type": "string"},
        "issued_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "applied_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "acknowledgement_id": {
          "oneOf": [{"$ref": "common.schema.json#/definitions/UUID"}, {"type": "null"}]
        },
        "acknowledgement_outcome": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "acknowledged_at": {
          "oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]
        }
      }
    },
    "WorkDetailRaw": {
      "type": "object",
      "additionalProperties": true,
      "description": "Unfiltered Protocol.task/1 snapshot and full timeline page behind the detail projection.",
      "required": ["task", "timeline", "next_before"],
      "properties": {
        "task": {"oneOf": [{"$ref": "#/definitions/TaskRead"}, {"type": "null"}]},
        "timeline": {"type": "array", "items": {"$ref": "#/definitions/WorkItemTimelineItem"}},
        "next_before": {"oneOf": [{"type": "string"}, {"type": "null"}]}
      }
    },
    "TaskRead": {
      "type": "object",
      "additionalProperties": true,
      "description": "Protocol.task/1 as served for the work item snapshot.",
      "required": [
        "task_id",
        "state",
        "run_id",
        "generation",
        "work",
        "result",
        "failure",
        "controls",
        "waiting",
        "latest_command"
      ],
      "properties": {
        "task_id": {"$ref": "common.schema.json#/definitions/UUID"},
        "state": {"type": "string"},
        "run_id": {"oneOf": [{"$ref": "common.schema.json#/definitions/UUID"}, {"type": "null"}]},
        "generation": {"type": "integer"},
        "work": {"$ref": "#/definitions/TaskWork"},
        "result": {
          "oneOf": [{"type": "object", "additionalProperties": true}, {"type": "null"}]
        },
        "failure": {
          "oneOf": [{"type": "object", "additionalProperties": true}, {"type": "null"}]
        },
        "controls": {"$ref": "#/definitions/TaskControls"},
        "waiting": {"oneOf": [{"$ref": "#/definitions/WorkItemWaiting"}, {"type": "null"}]},
        "latest_command": {
          "oneOf": [{"$ref": "#/definitions/WorkItemCommand"}, {"type": "null"}]
        }
      }
    },
    "TaskWork": {
      "type": "object",
      "additionalProperties": true,
      "required": ["goal", "agent_profile", "workspace", "input"],
      "properties": {
        "goal": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "agent_profile": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "workspace": {"oneOf": [{"type": "string"}, {"type": "null"}]},
        "input": {
          "oneOf": [{"type": "object", "additionalProperties": true}, {"type": "null"}]
        },
        "required_capabilities": {"type": "object", "additionalProperties": true}
      }
    },
    "TaskControls": {
