{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contracts/v1/evidence-batch.schema.json",
  "title": "Symmetry Evidence Batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "items"],
  "properties": {
    "schema_version": {"const": "symmetry.evidence_batch.v1"},
    "run_id": {"$ref": "common.schema.json#/definitions/UUID"},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "evidence.schema.json#"}
    }
  }
}
