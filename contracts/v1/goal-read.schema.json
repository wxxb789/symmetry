{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contracts/v1/goal-read.schema.json",
  "title": "Symmetry Goal Read v1",
  "description": "Consumed members of the Portal Goal detail read: the existing Goal projection with objective, accepted progress, blockers, the server's own allowed actions, settlement attention, budget reservation and consumption, waiting-external boundaries and the read-only dependency projection. Every member a surface consumes that the projection always serves is required (a served null stays nullable), so renaming one cannot pass every gate while the client silently reads undefined; unconsumed presentation members remain additive, and the client never derives a Goal policy member and never offers an action the served allowed_actions does not list.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "project_id",
    "project_key",
    "title",
    "state",
    "current_revision",
    "version",
    "revision",
    "blockers",
    "blocker_reasons",
    "settlement_attention",
    "completion",
    "allowed_actions",
    "work_items",
    "graph",
    "decisions",
    "accepted_outcomes",
    "accounting",
    "external_waits"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/definitions/UUID"
    },
    "project_id": {
      "$ref": "common.schema.json#/definitions/UUID"
    },
    "project_key": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "project_name": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "current_revision": {
      "$ref": "common.schema.json#/definitions/PositiveInteger"
    },
    "version": {
      "$ref": "common.schema.json#/definitions/SafeInteger",
      "description": "Goal lock_version: the value every command must carry as expected_version."
    },
    "updated_at": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "lifecycle": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "oneOf": [
        {
          "$ref": "#/definitions/GoalReadRevision"
        },
        {
          "type": "null"
        }
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/GoalBlocker"
      }
    },
    "blocker_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "settlement_attention": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/SettlementAttention"
      }
    },
    "attention_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completion": {
      "$ref": "#/definitions/GoalCompletion"
    },
    "allowed_actions": {
      "type": "array",
      "description": "The server's exact action list for the rendered version/revision. The surface offers this list and nothing else.",
      "items": {
        "type": "string"
      }
    },
    "work_items": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/GoalReadWorkItem"
      }
    },
    "graph": {
      "$ref": "#/definitions/GoalReadGraph"
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/GoalReadDecision"
      }
    },
    "accepted_outcomes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/GoalReadOutcome"
      }
    },
    "accounting": {
      "$ref": "#/definitions/GoalReadAccounting"
    },
    "external_waits": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/GoalReadExternalWait"
      }
    },
    "history": {
