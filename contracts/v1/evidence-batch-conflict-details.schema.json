{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contracts/v1/evidence-batch-conflict-details.schema.json",
  "title": "Symmetry Evidence Batch Conflict Details v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"$ref": "#/definitions/ConflictItem"}
    }
  },
  "definitions": {
    "ConflictItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "evidence_key", "disposition"],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 255},
        "evidence_key": {"$ref": "common.schema.json#/definitions/ShortIdentifier"},
        "disposition": {"const": "conflict"}
      }
    }
  }
}
