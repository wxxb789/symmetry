{
  "name": "symmetry-browser-acceptance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "lint": "eslint .",
    "test:connection-env": "node --test scripts/connection-spec-env.test.mjs",
    "test:control-isolation": "node --test scripts/control-instance-isolation.test.mjs",
    "test:control": "playwright test tests/portal-execution-control.spec.mjs tests/portal-goal-managed.spec.mjs",
    "test:compose": "playwright test tests/portal-compose-daemon.spec.mjs --project=desktop-chromium",
    "test:compose:read": "playwright test tests/portal-compose-restart.spec.mjs --project=desktop-chromium",
    "test:live": "playwright test tests/portal-live-daemon.spec.mjs --project=desktop-chromium",
    "test:headed": "playwright test --headed",
    "show-report": "playwright show-report"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "eslint": "10.14.0",
    "globals": "17.14.0"
  }
}
